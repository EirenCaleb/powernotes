Options -Indexes
<FilesMatch "^(config\.sample\.php|powernotes_config\.local\.php|schema\.sql|README\.md|\.ht.*)$">
  Require all denied
</FilesMatch>
# Pass the Authorization header through to PHP (needed on some Apache/LiteSpeed setups)
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
